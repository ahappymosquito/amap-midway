[Unit]
Description=amap-find dual-point place search
After=network.target

[Service]
Type=simple
User=ts3
Group=ts3
WorkingDirectory=/home/ts3/amap_find
EnvironmentFile=/home/ts3/amap_find/.env
ExecStart=/home/ts3/amap_find/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
